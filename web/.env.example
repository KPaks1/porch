# Copy to .env and adjust.
# Every VITE_* variable is built into the JavaScript bundle and is PUBLIC.
# Never put secrets here.

# Base URL of the API (no trailing slash, no version).
# Leave empty in development: requests go to the same origin and the Vite
# dev proxy (vite.config.ts) forwards them to http://localhost:3000.
# In production (Vercel), set to the deployed API, e.g. https://api.porch.example
VITE_API_URL=