# Copy to .env and adjust. Values below match docker-compose.yml.

# Development database
DATABASE_URL=postgresql://porch:porch@localhost:5432/porch

# E2E test database (created by docker/postgres/init on first start)
TEST_DATABASE_URL=postgresql://porch:porch@localhost:5432/porch_test

# JWT secret for signing tokens. Change this to a secure value in production.
JWT_SECRET=notsosupersecretjwtkey